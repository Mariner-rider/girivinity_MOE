APP_NAME=Girivinity
APP_ENV=dev
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true
AUTO_LOAD_MODEL=false
MODEL_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0
MODEL_DEVICE_MAP=auto
MODEL_LOAD_IN_4BIT=true
MODEL_USE_DOUBLE_QUANT=true
MODEL_QUANT_TYPE=nf4
MODEL_COMPUTE_DTYPE=float16

DATABASE_PASSWORD=

# API Authentication & Authorization (leave blank; inject via secret manager or .env)
# Comma-separated API keys for each role; no default keys are active.
GIRIVINITY_ADMIN_API_KEYS=
GIRIVINITY_SERVICE_API_KEYS=
GIRIVINITY_USER_API_KEYS=
RASP_API_KEYS=
# Optional key rotation / revocation controls
GIRIVINITY_REVOKED_KEYS=
GIRIVINITY_REVOKED_KEY_HASHES=
# Optional PostgreSQL-backed session bearer validation (true/false)
GIRIVINITY_ENABLE_SESSION_AUTH=false
# Rate limit (requests per minute per IP) for public chat endpoints
GIRIVINITY_PUBLIC_CHAT_RPM=50
